{
  "name": "pixel-birder",
  "private": true,
  "version": "1.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && rm -rf docs && cp -r dist docs && touch docs/.nojekyll",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "tsx scripts/gen-icons.ts",
    "silhouettes": "tsx scripts/silhouette-sheet.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
